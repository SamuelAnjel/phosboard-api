# Phosboard v2.0.0+ Environment Variables Example
# Copy this file to .env and fill in your values

# ===== Apify Configuration (Required for real social media monitoring) =====
APIFY_API_TOKEN=your_apify_api_token_here
APIFY_ACTOR_ID=apify/actor-twitter-scraper

# ===== Database Configuration =====
DATABASE_URL=postgresql://user:password@host:port/database

# ===== Google Cloud Configuration =====
GOOGLE_PROJECT_ID=phosboard
GCS_BUCKET_NAME=phosboard-documents

# ===== Backend API Configuration =====
PORT=8080

# ===== Pub/Sub Emulator (Local Development) =====
# PUBSUB_EMULATOR_HOST=localhost:8085

# ===== Optional: Vertex AI for semantic analysis =====
# GOOGLE_APPLICATION_CREDENTIALS=path/to/credentials.json
# VERTEX_AI_PROJECT=your-project-id
# VERTEX_AI_LOCATION=us-central1